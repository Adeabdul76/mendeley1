{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panel.json",
  "title": "PanelScript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "shot",
    "setting",
    "characters",
    "action",
    "dialogue",
    "caption",
    "sfx"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^p[0-9]+-[1-6]$"
    },
    "shot": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "setting": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500
    },
    "characters": {
      "type": "array",
      "maxItems": 6,
      "description": "Exactly which characters are visible. Drives the image prompt and the QA count check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "pose": {
            "type": "string",
            "maxLength": 250
          },
          "expression": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 2,
      "maxLength": 800
    },
    "dialogue": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker",
          "text",
          "type"
        ],
        "properties": {
          "speaker": {
            "$ref": "common.json#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "type": {
            "enum": [
              "speech",
              "thought",
              "shout",
              "whisper"
            ]
          }
        }
      }
    },
    "caption": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "sfx": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    }
  }
}
