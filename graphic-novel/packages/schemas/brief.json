{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.json",
  "title": "BookBrief",
  "description": "Normalised customer brief produced by stage [1] Intake & safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["book_type", "language", "trim_size", "characters", "brief", "consent"],
  "properties": {
    "book_type": { "$ref": "common.json#/$defs/bookType" },
    "language": { "$ref": "common.json#/$defs/language" },
    "trim_size": { "$ref": "common.json#/$defs/trimSize" },
    "page_count": { "type": "integer", "minimum": 8, "maximum": 64, "multipleOf": 4, "default": 32 },
    "characters": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": { "$ref": "character.json" }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "occasion": { "type": "string", "maxLength": 200 },
        "setting": { "type": "string", "maxLength": 300 },
        "tone": { "type": "string", "maxLength": 200 },
        "inside_jokes": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
        "avoid": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "dedication": { "type": "string", "maxLength": 400 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photos_permission_confirmed", "confirmed_at"],
      "properties": {
        "photos_permission_confirmed": { "const": true },
        "confirmed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
