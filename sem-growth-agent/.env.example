# Copy this file to .env and fill in only what you use. Never commit .env.

# Claude (drafting + triage)
ANTHROPIC_API_KEY=

# Whop: create a key in your Whop dashboard (Developer > API keys)
WHOP_API_KEY=
WHOP_COMPANY_ID=            # starts with biz_ ; needed only to create discount codes

# YouTube Data API: API key for reading; OAuth client file for posting replies
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_CHANNEL_ID=         # your own channel, so the agent can see comments on your videos

# Reddit (script app from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=sem-growth-agent/0.1 by u/your_username

# X API v2 (search needs a paid tier; leave blank to skip X)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
